# Dependencies & build output (reinstalled/rebuilt inside the image)
node_modules
.next
out
build
coverage

# Secrets & local config — never copy into the image
.env
.env.*
!.env.example
docker-compose.yml
docker-compose.override.yml
*.secret
secrets.*

# Version control & CI
.git
.gitignore
.github

# Editor / OS cruft
.vscode
.idea
.DS_Store
*.pem

# Docs & meta (not needed at runtime)
docs
README.md
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
